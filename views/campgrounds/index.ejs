<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campgrounds List</title>
</head>
<body>
    <h1>Campgrounds List</h1>
    <div>
        <a href="/campgrounds/new">Add Campground</a>
    </div>
    <div>
        <ul>
            <% for (let c of campgrounds) { %>
                <li><a href="/campgrounds/<%= c._id %>"><%= c.title %></a></li>
            <% } %>
        </ul>
    </div>
</body>
</html>