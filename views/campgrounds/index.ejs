<% layout("layouts/boilerplate") -%>

<div class="row">
    <div class="col-12">
        <div class="mb-3" id='map' style='height: 250px;'></div>
    </div>
</div>

<h1>All Campgrounds</h1>

<div class="row">
    <% for (let c of campgrounds) { %>
    <div class="col-12">
        <div class="card my-3 w-100 rounded-0">
            <div class="row g-0">
                <div class="col-md-4">
                    <img src="<%= c.images[0]?.url %>" loading="lazy" decoding="async" class="img-fluid w-100 h-100 object-fit-cover" alt="">
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title"><%= c.title %></h5>
                        <p class="card-text">
                            <small class="text-muted"><%= c.location%></small>
                        </p>
                        <p class="card-text"><%= c.description %></p>
                        <a href="/campgrounds/<%= c._id %>" class="btn btn-primary">View <%= c.title %></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>
</div>

<nav aria-label="Campgrounds pages" class="mt-3">
    <ul class="pagination justify-content-center">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"> 
            <a class="page-link" href="?page=<%= page - 1 %>&limit=<%= limit %>">
                <span aria-hidden="true">&laquo;</span>
            </a> 
        </li> 
        <% for (let p = 1; p <= totalPages; p++) { %> 
        <li class="page-item <%= p === page ? 'active' : '' %>">
             <a class="page-link" href="?page=<%= p %>&limit=<%= limit %>"><%= p %></a> 
        </li> 
        <% } %> 
        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>"> 
            <a class="page-link" href="?page=<%= page + 1 %>&limit=<%= limit %>">
                <span aria-hidden="true">&raquo;</span>
            </a> 
        </li>
    </ul>
</nav>

<script>
    const mapAccessToken = '<%- process.env.MAPBOX_ACCESS_TOKEN %>';
    const allGeometries = <%- JSON.stringify(
        allGeometries.map(data => (
            {
                type: "Feature",
                geometry: data.geometry,
                properties: {
                    title: data.title,
                    link: `/campgrounds/${data._id}`
                }
            }
        ))
    ) %>;
</script>
<script src="/js/clusterMap.js"></script>