<% layout("layouts/boilerplate") -%>

<div class="row">
    <div class="col-12 col-md-6">
        <div class="card mb-3">
            <img src="<%= campground.image %>" alt="" class="card-img-top">
            <div class="card-body">
                <h5 class="card-title">
                    <%= campground.title %>
                </h5>
                <p class="card-text">
                    <%= campground.description %>
                </p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <small class="text-muted"><%= campground.location%></small>
                </li>
                <li class="list-group-item">
                    <p class="card-text">Submitted by <%= campground.author.equals(currentUser) ? "You" : campground.author.username %></p>
                </li>
                <li class="list-group-item">
                    <p class="card-text">$<%= campground.price %> / night</p>
                </li>
            </ul>
            <% if (campground.author.equals(currentUser)) { %>
                <div class="card-body">
                    <a href="/campgrounds/<%= campground._id %>/edit" class="btn btn-info">Edit</a>
                    <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <h4>Leave a Review</h4>
        <div class="card mt-3">
            <div class="card-body">
                <form action="/campgrounds/<%= campground._id %>/reviews" method="post" class="needs-validation" novalidate>
                    <div>
                        <textarea name="review[content]" id="review" class="form-control" placeholder="Leave some reviews here ..." required></textarea>
                        <div class="invalid-feedback">
                            No blank review
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-3">
                        <div class="star-rating animated-stars">
                            <input type="radio" id="star5" name="review[rating]" value="5" required>
                            <label for="star5" class="bi bi-star-fill"></label>
                            <input type="radio" id="star4" name="review[rating]" value="4" required>
                            <label for="star4" class="bi bi-star-fill"></label>
                            <input type="radio" id="star3" name="review[rating]" value="3" required>
                            <label for="star3" class="bi bi-star-fill"></label>
                            <input type="radio" id="star2" name="review[rating]" value="2" required>
                            <label for="star2" class="bi bi-star-fill"></label>
                            <input type="radio" id="star1" name="review[rating]" value="1" required>
                            <label for="star1" class="bi bi-star-fill"></label>
                            <div class="invalid-feedback" style="text-align: left;">    <!-- Must set text-algin: left OR direction: ltr -->
                                Please select a rating
                            </div>
                        </div>
                        <button class="btn btn-success">Submit</button>
                    </div>
                </form>
            </div>
        </div>
        <h4 class="mt-3">All Reviews</h4>
        <% for (let r of campground.reviews) { %>
            <div class="card mt-3">
                <div class="card-body">
                    <p><%= r.content %> - (<b><%= r.rating %>/5&#9733;</b>)</p>
                    <form action="/campgrounds/<%= campground._id %>/reviews/<%= r._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
</div>