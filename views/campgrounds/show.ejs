<% layout("layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/starability-basic.min.css">

<div class="row">
    <div class="col-12 col-md-6">
        <div class="card mb-3">
            <div id="image-carousel" class="carousel slide card-img-top">
                <div class="carousel-indicators">
                    <% campground.images.forEach((img, i) => { %>
                    <button type="button" data-bs-target="#image-carousel" data-bs-slide-to="<%= i %>" class="<%= i===0 ? 'active' : '' %>"></button>
                    <% } ) %>
                </div>
                <div class="carousel-inner">
                    <% campground.images.forEach((img, i) => { %>
                    <div class="carousel-item <%= i===0 ? "active" : "" %>">
                        <img src="<%= img.url %>" class="d-block w-100" alt="...">
                    </div>
                    <% } ) %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#image-carousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#image-carousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
            <div class="card-body">
                <h5 class="card-title">
                    <%= campground.title %>
                </h5>
                <p class="card-text">
                    <%= campground.description %>
                </p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <small class="text-muted"><%= campground.location%></small>
                </li>
                <li class="list-group-item">
                    <p class="card-text">Submitted by <%= campground.author.equals(currentUser) ? "You" : campground.author.username %></p>
                </li>
                <li class="list-group-item">
                    <p class="card-text">$<%= campground.price %> / night</p>
                </li>
            </ul>
            <% if (campground.author.equals(currentUser)) { %>
                <div class="card-body">
                    <a href="/campgrounds/<%= campground._id %>/edit" class="btn btn-info">Edit</a>
                    <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
    <div class="col-12 col-md-6 d-md-flex flex-md-column">
        <% if (currentUser) { %>
            <h4>Leave a Review</h4>
            <div class="card mt-3">
                <div class="card-body">
                    <form action="/campgrounds/<%= campground._id %>/reviews" method="post" class="needs-validation" novalidate>
                        <div>
                            <textarea name="review[content]" id="review" class="form-control" placeholder="Leave some reviews here ..." required></textarea>
                            <div class="invalid-feedback">
                                No blank review
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <div class="star-rating animated-stars">
                                <input type="radio" id="star5" name="review[rating]" value="5" required>
                                <label for="star5" class="bi bi-star-fill"></label>
                                <input type="radio" id="star4" name="review[rating]" value="4" required>
                                <label for="star4" class="bi bi-star-fill"></label>
                                <input type="radio" id="star3" name="review[rating]" value="3" required>
                                <label for="star3" class="bi bi-star-fill"></label>
                                <input type="radio" id="star2" name="review[rating]" value="2" required>
                                <label for="star2" class="bi bi-star-fill"></label>
                                <input type="radio" id="star1" name="review[rating]" value="1" required>
                                <label for="star1" class="bi bi-star-fill"></label>
                                <div class="invalid-feedback" style="text-align: left;">    <!-- Must set text-algin: left OR direction: ltr -->
                                    Please select a rating
                                </div>
                            </div>
                            <button class="btn btn-success">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        <% } %>
        <% if (campground.reviews.length === 0) { %>
            <div class="flex-grow-1 d-md-flex align-items-center justify-content-center <%= currentUser ? 'mt-3 mt-md-0' : '' %>">
                <h4>No Review Yet</h4>
            </div>
        <% } else { %>
            <h4 class="<%= currentUser ? 'mt-3' : '' %>">All Reviews</h4>
            <% for (let r of campground.reviews) { %>
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="starability-result card-title" data-rating=<%= r.rating %>></h5>
                        <h6 class="card-subtitle mt-3 text-body-secondary">
                            By <%= currentUser && currentUser._id.equals(r.author._id) ? "You" : r.author.username %>
                        </h6>
                        <p class="mt-3 mb-0"><%= r.content %></p>
                        <% if (currentUser && currentUser._id.equals(r.author._id)) { %>
                            <form class="mt-3" action="/campgrounds/<%= campground._id %>/reviews/<%= r._id %>?_method=DELETE" method="POST">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>
</div>